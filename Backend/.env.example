PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/filmvisarna

JWT_SECRET=your_jwt_secret_key_that_is_at_least_32_characters_long
# Maximum session lifetime; existing deployment values override the code default.
JWT_EXPIRES_IN=8h

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=filmvisarna
DB_SSL=false

# Email Service (Nodemailer)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
SEED_USER_PASSWORD=

# Optional server-side TMDB v3 API key for admin movie import. Never expose in the frontend.
TMDB_API_KEY=
TMDB_API_BASE_URL=https://api.themoviedb.org/3

# Booking protection (run npm run migrate:bookings before deployment)
BOOKING_ATTEMPTS_PER_15_MIN=3
BOOKING_IP_ATTEMPTS_PER_15_MIN=30
BOOKING_GLOBAL_ATTEMPTS_PER_15_MIN=300
BOOKING_MAX_SEATS_PER_SCREENING=10
BOOKING_MAX_UNPAID_BOOKINGS=3
BOOKING_MAX_UNPAID_SEATS=20
BOOKING_EMAILS_PER_15_MIN=3
BOOKING_EMAIL_COOLDOWN_SECONDS=60
BOOKING_GLOBAL_EMAILS_PER_15_MIN=60
BOOKING_GUEST_LINK_MINUTES=10
# Comma-separated trusted proxy IPs/CIDRs only. Leave empty for direct access.
TRUST_PROXY=
